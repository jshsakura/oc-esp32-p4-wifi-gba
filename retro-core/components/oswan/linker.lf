# oswan's state goes to PSRAM.
#
# This core was a standalone app until it was folded into retro-core, and folding
# trades one ceiling for another: the flash saving is a whole ~950KB framework
# copy and a partition, but every static the core carries now lands in the same
# internal RAM as the systems already here. WS.c's IRAM[0x10000] and
# MemDummy[0x10000] plus ws_fileio.c's ws_cart_ram are 192KB between them, and
# adding them was enough to fail the link with esp-idf's "discards section",
# which is how it reports running out of internal RAM (BRINGUP 0.3-2).
#
# The scheme is defined here rather than reusing esp-idf's extram_bss: that one
# lives in esp_wifi's fragment, and this app builds with networking off, so the
# name resolves to nothing -- silently, leaving the link failing at exactly the
# same byte count as before.
[scheme:oswan_extram]
entries:
    bss -> extern_ram
    common -> extern_ram
    # RISC-V's small-data sections too. Without this line the base linker script
    # pulls .sbss/.scommon into internal RAM unconditionally, and the mapping
    # looks like it worked right up until something else needs the space.
    legacy_bss -> extern_ram

[mapping:oswan_bss]
archive: liboswan.a
entries:
    * (oswan_extram)
