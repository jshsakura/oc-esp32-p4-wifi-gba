# main_zxs.c's `static zx_t zx` (the whole ZX Spectrum machine -- 48K RAM,
# ROM, AY/beeper/kbd state) is ~325KB, declared as a translation-unit static in
# the shared "main" component rather than in zxs's own component library. It
# can't be handled by retro-core/components/zxs/linker.lf, which only reaches
# libzxs.a -- this file lives in libmain.a alongside every other folded core's
# main_<x>.c, and by the time zxs was the third core folded in one sitting,
# that struct alone was enough to fail the link with esp-idf's "discards
# section" (BRINGUP 0.3-2).
#
# Scoped to main_zxs.c.obj specifically, not the whole archive: the other
# main_<x>.c files' statics (vidBuf, lookup tables, ...) already fit internal
# RAM on their own, and moving them too would only add PSRAM latency they don't
# need.
[scheme:main_extram]
entries:
    bss -> extern_ram
    common -> extern_ram
    legacy_bss -> extern_ram

[mapping:main_zxs_bss]
archive: libmain.a
entries:
    main_zxs (main_extram)
