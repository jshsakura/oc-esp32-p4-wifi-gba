#
# SPI Driver - For display and SD card
#
#
# I2S
#
# Without this the driver allocates its channel object with MALLOC_CAP_DEFAULT, which on a
# board with PSRAM lands outside internal RAM -- and GDMA refuses to register a callback
# whose user context it cannot reach from an ISR, so audio never initialises at all.
CONFIG_I2S_ISR_IRAM_SAFE=y

# Inherited from a target whose panel was on SPI. This one's panel is MIPI DSI and its card
# is SDMMC 4-bit, so nothing here touches the SPI master or slave driver on a hot path -- and
# the IRAM it was holding is in sram_low, the same region .sdata has to fit in. Linking the
# PPA driver for the display blit put retro-core 775 bytes over and the link began discarding
# sections it could not place; this is where that came back from.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_SPI_MASTER_IN_IRAM=n
CONFIG_SPI_SLAVE_IN_IRAM=n

#
# SPI RAM (PSRAM) - Critical for game ROMs and frame buffers
#
#
# PSRAM and flash were asking for speeds Kconfig could not give them
#
# CONFIG_SPIRAM_SPEED_200M and CONFIG_ESPTOOLPY_FLASHFREQ_120M are both gated behind
# IDF_EXPERIMENTAL_FEATURES on the ESP32-P4. Without it the choice symbols are not
# selectable at all, and Kconfig quietly fell back to the slowest option in each list --
# the device booted at *20MHz* PSRAM and 80MHz flash while this file said 200 and 120,
# and `esp_psram: Speed: 20MHz` in the boot log was the only sign of it.
#
# That is a tenfold cut on every PSRAM access, which is where every frame buffer, every
# ROM and every core's working set lives. Measured before/after in BRINGUP A13.
#
# Flash stays at 80MHz. 120MHz needs the chip's high-performance mode, and this board's
# GD25Q256 answers "High performance mode of this flash model hasn't been supported" -- so
# CONFIG_ESPTOOLPY_FLASHFREQ_120M above is a request Kconfig will keep declining. Left as
# it is rather than edited to 80, so the next person sees the same warning and stops here
# too instead of re-deriving it.
#
# The bootloader initialises PSRAM (CONFIG_SPIRAM_BOOT_HW_INIT), so changing this speed
# means reflashing the bootloader, not just an app partition. Flashing one app against a
# bootloader built for the old speed boot-loops the device on the watchdog.

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
# 20, not 80, and this is a loss worth understanding rather than a setting.
#
# 80MHz is stable for the launcher, gbsp, gwenesis and ngpocket-go, and it is worth about
# three times on everything that touches PSRAM -- the display blit went from 23.4ms to 7.7ms
# a frame on GBA, which is the difference between 60fps being reachable and not (A13/A14).
#
# It boot-loops retro-core. Reproducibly, on a freshly written partition, with flash at both
# 120MHz and 40MHz, so it is not MSPI contention with the flash. The second-stage bootloader
# stops after `entry 0x4ff29ed0` without printing one line of its own and the watchdog takes
# it -- the app never starts, so this is the loader reading a 1.7MB image, not anything
# retro-core does. Every other app is around 1MB.
#
# retro-core carries eleven of the twenty-two systems, so 80MHz cannot ship until that is
# understood. Next step is esp-idf's own MSPI timing diagnostics, which are ESP_EARLY_LOGD
# and therefore compiled out at this project's log level -- build once with the log level
# raised and compare the tuning point the bootloader picks on a launcher boot against a
# retro-core boot.
CONFIG_SPIRAM_SPEED_20M=y
CONFIG_SPIRAM_SPEED=20
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
# Off: this walks all 32MB on every boot and costs 3.8 seconds, measured. It is a bring-up
# diagnostic, and every game switch here is a reboot into another app partition, so that
# time is paid each time you change games.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

