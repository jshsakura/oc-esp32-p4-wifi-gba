CONFIG_ESP_SYSTEM_IN_IRAM=y

# The heap's 7.9KB of code moves to flash. IRAM here means sram_low, which is 183KB and
# already holds 176KB -- the emulator cores put their hot loops there on purpose, snes9x
# alone taking 41KB, and a malloc that runs from cached flash costs nothing next to that.
# This is what made room for the PPA driver the display blit needs. Safe as long as no
# heap_caps function is called from an IRAM ISR while the cache is off, and none is.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MINIMAL_SHARED_STACK_SIZE=2048
